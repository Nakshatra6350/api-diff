{
  "name": "@nakshatra6350/api-diff",
  "version": "0.4.1",
  "type": "module",
  "description": "Runtime API contract drift detector for frontend apps",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./axios": {
      "types": "./dist/axios.d.ts",
      "import": "./dist/axios.js",
      "require": "./dist/axios.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/axios.ts --format cjs,esm --dts --splitting",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src"
  },
  "license": "MIT",
  "peerDependencies": {
    "axios": ">=0.21.0"
  },
  "peerDependenciesMeta": {
    "axios": {
      "optional": true
    }
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.9.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nakshatra6350/api-diff.git"
  },
  "homepage": "https://github.com/Nakshatra6350/api-diff#readme",
  "bugs": {
    "url": "https://github.com/Nakshatra6350/api-diff/issues"
  }
}
